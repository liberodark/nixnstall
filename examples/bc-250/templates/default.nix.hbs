{ pkgs, ... }:
{
  imports = [
    ../bc250/hardware.nix
    ./disko.nix
{{#if hardwareConfig}}    ./hardware-configuration.nix
{{/if}}
{{#each imports}}    {{this}}
{{/each}}{{#if opts.gamescope}}    ../../extras/gamescope-session.nix
{{/if}}{{#if opts.bigPicture}}    ../../extras/steam-bigpicture.nix
{{/if}}{{#if opts.decky}}    ../../extras/decky.nix
{{/if}}  ];

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  networking.hostName = "{{hostname}}";
{{#if (eq opts.zram "off")}}
  zramSwap.enable = false;
{{else}}
  zramSwap.enable = true;
  zramSwap.memoryPercent = {{opts.zram}};
{{/if}}

  services.openssh.enable = {{#if opts.sshd}}true{{else}}false{{/if}};
  networking.firewall.enable = {{#if opts.firewall}}true{{else}}false{{/if}};

{{#unless (eq opts.gpuClock "1500")}}
  # Curve taken from the governor's own default-config.toml, which is the
  # reference for the daemon we run; 1800 and 1900 are interpolated inside it.
  # Above 2000 the governor author and the community docs disagree (2230:
  # 1085 vs 1060 mV, 2300: 1110 vs 1075 mV); the docs' lower figures are used,
  # and 1085 mV is their stated maximum recommendation.
  # The governor clamps to its highest safe-point, so the curve has to reach
  # the ceiling. Never below 700 mV: the GPU re-locks itself to 1500 MHz.
  hardware.bc250.governor.settings = {
    frequency-range.max = {{opts.gpuClock}};
    safe-points = [
      { frequency = 500; voltage = 700; }
      { frequency = 1000; voltage = 800; }
      { frequency = 1175; voltage = 850; }
      { frequency = 1500; voltage = 900; }
{{#if (gte opts.gpuClock "1600")}}      { frequency = 1600; voltage = 910; }
{{/if}}{{#if (gte opts.gpuClock "1700")}}      { frequency = 1700; voltage = 920; }
{{/if}}{{#if (gte opts.gpuClock "1800")}}      { frequency = 1800; voltage = 925; }
{{/if}}{{#if (gte opts.gpuClock "1850")}}      { frequency = 1850; voltage = 930; }
{{/if}}{{#if (gte opts.gpuClock "1900")}}      { frequency = 1900; voltage = 940; }
{{/if}}{{#if (gte opts.gpuClock "2000")}}      { frequency = 2000; voltage = 960; }
{{/if}}{{#if (gte opts.gpuClock "2100")}}      { frequency = 2100; voltage = 1000; }
{{/if}}{{#if (gte opts.gpuClock "2230")}}      { frequency = 2230; voltage = 1060; }
{{/if}}{{#if (gte opts.gpuClock "2300")}}      { frequency = 2300; voltage = 1075; }
{{/if}}    ];
  };
{{/unless}}

  console.keyMap = "{{opts.keymap}}";
  time.timeZone = "{{opts.timezone}}";

  i18n.defaultLocale = "{{opts.locale}}";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "{{opts.locale}}";
    LC_IDENTIFICATION = "{{opts.locale}}";
    LC_MEASUREMENT = "{{opts.locale}}";
    LC_MONETARY = "{{opts.locale}}";
    LC_NAME = "{{opts.locale}}";
    LC_NUMERIC = "{{opts.locale}}";
    LC_PAPER = "{{opts.locale}}";
    LC_TELEPHONE = "{{opts.locale}}";
    LC_TIME = "{{opts.locale}}";
  };

  services.xserver.xkb.layout = "{{opts.keymap}}";

  services.xserver.videoDrivers = [ "{{opts.videoDriver}}" ];
{{#if opts.cu40}}
  boot.kernelParams = [ "amdgpu.bc250_cc_write_mode=3" ];
{{/if}}
{{#if opts.autoLogin}}{{#unless opts.gamescope}}
  services.displayManager.autoLogin.enable = true;
  services.displayManager.autoLogin.user = "{{username}}";
{{/unless}}{{/if}}
{{#unless opts.gamescope}}{{#if vars.displayManager}}
  {{vars.displayManager}}.enable = true;
{{/if}}{{/unless}}
{{#if opts.gamescope}}
  # Jovian's autoStart brings its own SDDM and warns that a traditional
  # display manager cannot be enabled alongside it, so the desktop's own one
  # is only turned on when gamescope is off.
  jovian.steam.user = "{{username}}";
  jovian.steam.autoStart = {{#if opts.steamAutoStart}}true{{else}}false{{/if}};
{{#if vars.session}}
  jovian.steam.desktopSession = "{{vars.session}}";
{{/if}}
{{/if}}
{{#if opts.decky}}
  jovian.decky-loader.user = "{{username}}";
{{/if}}
{{#unless (eq opts.shell "bash")}}
  programs.{{opts.shell}}.enable = true;
{{/unless}}

{{#if (eq opts.browser "firefox")}}
  programs.firefox.enable = true;
{{/if}}
{{#unless (eq opts.browser "firefox")}}{{#unless (eq opts.browser "none")}}
  environment.systemPackages = [ pkgs.{{opts.browser}} ];
{{/unless}}{{/unless}}

  users.users."{{username}}" = {
    isNormalUser = true;
    shell = pkgs.{{opts.shell}};
    extraGroups = [
      "wheel"
      "video"
      "audio"
      "input"
      "networkmanager"
    ];
    hashedPassword = "{{hashedPassword}}";
  };

{{#if (eq layout "bcachefs")}}
  boot.supportedFilesystems.bcachefs = true;
{{/if}}
{{#if (eq layout "f2fs")}}
  boot.supportedFilesystems.f2fs = true;
{{/if}}
{{#if (eq layout "btrfs")}}
  services.btrfs.autoScrub = {
    enable = true;
    interval = "monthly";
    fileSystems = [ "/" ];
  };
{{/if}}
  system.stateVersion = "26.05";
}
